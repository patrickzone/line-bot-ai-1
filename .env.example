# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (.env.local ถูก gitignore ไว้แล้ว)
# บน Vercel ใส่ 4 ตัวนี้ที่ Settings → Environment Variables แล้ว redeploy 1 ครั้ง

# LINE Developers Console → Messaging API → Channel secret
LINE_CHANNEL_SECRET=

# LINE Developers Console → Messaging API → Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=

# Google AI Studio → API key
GEMINI_API_KEY=

# ลิงก์ CSV ของ Google Sheet — ห้ามใช้ลิงก์ /edit จาก address bar (จะได้ HTML ไม่ใช่ข้อมูล)
#
# ชีตต้องเปิดให้คนนอกอ่านได้ก่อน ไม่งั้นจะโดน 401 เลือกทางใดทางหนึ่ง:
#   ก) Share → General access → Anyone with the link → Viewer
#      แล้วใช้ https://docs.google.com/spreadsheets/d/<SHEET_ID>/export?format=csv&gid=<GID>
#   ข) File → Share → Publish to web → เลือกชีต → Comma-separated values (.csv)
#      แล้วใช้ลิงก์ที่ได้ (จะมี /d/e/2PACX-... และลงท้าย output=csv)
#
# โค้ดรับชื่อ SHEET_CSV_URL ด้วย ถ้าตั้งชื่อนั้นไว้แล้วไม่ต้องเปลี่ยน
FAQ_SHEET_CSV_URL=

# ไม่บังคับ — ใส่เมื่ออยากเปลี่ยนรุ่นโมเดลโดยไม่ต้องแก้ lib/config.ts
# GEMINI_MODEL=
